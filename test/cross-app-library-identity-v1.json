      "metadata": { "game": "Castlevania", "system": "Playstation" },
      "route": { "pluginID": "play-psf", "formatExtension": "psf" },
      "expected": {
        "collection": { "game": "Castlevania", "system": "Sony PlayStation" },
        "embedded": { "game": "Castlevania", "system": "Sony PlayStation" }
      }
